                        "minLength": 1
                      },
                      "description": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "name",
                      "description"
                    ]
                  }
                },
                "required": []
              }
            }
          }
        }
      }
